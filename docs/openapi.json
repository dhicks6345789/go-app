{
  "openapi": "3.0.3",
  "info": {
    "title": "Go Self-Contained App API",
    "description": "API documentation for the self-contained Go application framework.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns operational status of the service.",
        "responses": {
          "200": {
            "description": "Healthy response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user": {
      "get": {
        "summary": "Get Current User",
        "description": "Returns authenticated user info based on environment or proxy headers.",
        "responses": {
          "200": {
            "description": "User info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": { "type": "string", "example": "alice" },
                    "auth_type": { "type": "string", "example": "local_env" },
                    "mode": { "type": "string", "example": "desktop" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "summary": "System Info",
        "description": "Returns system metrics, Go version, OS/Arch, and uptime.",
        "responses": {
          "200": {
            "description": "System status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": { "type": "string", "example": "desktop" },
                    "go_version": { "type": "string", "example": "go1.24.4" },
                    "os": { "type": "string", "example": "linux" },
                    "arch": { "type": "string", "example": "amd64" },
                    "uptime": { "type": "string", "example": "12m30s" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/items": {
      "get": {
        "summary": "List Items",
        "description": "Returns all stored items.",
        "responses": {
          "200": {
            "description": "List of items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Item"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Item",
        "description": "Creates a new item.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "Sample Item" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Sample Item" },
          "created_by": { "type": "string", "example": "alice" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
